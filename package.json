{
  "name": "microsoft-foundry-engineer-mcp",
  "version": "0.1.0",
  "description": "MCP workbench for Microsoft Foundry engineering, operations, and EU AI Act readiness checks.",
  "type": "module",
  "bin": {
    "microsoft-foundry-engineer-mcp": "./dist/server.js"
  },
  "scripts": {
